# Pooled connection string from Neon (Vercel Marketplace sets this as DATABASE_URL).
# The app runtime reads DATABASE_URL, then POSTGRES_URL.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct (non-pooled) Neon URL. Use this for migrations if the pooled URL fails.
# drizzle-kit reads DATABASE_URL_UNPOOLED first, then DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# Shared admin password for /admin. Friends never see this.
ADMIN_PASSWORD=replace-with-a-long-password

# Secret for the invite link: https://your-app.vercel.app/join/THIS_VALUE
# Use a long URL-safe token (letters, numbers, hyphen). Rotating it logs everyone out;
# they get back in with the same name and PIN.
INVITE_TOKEN=replace-with-a-long-random-token

# OddsPapi v4 key. Leave blank to show projected prices only.
# One unibet tournament call every 6 hours, about 124 requests a month (free tier is 250).
# The first refresh also calls /fixtures once, to map participant ids.
ODDSPAPI_API_KEY=
# PGL Major Singapore. Override only if OddsPapi assigns a new tournament id.
ODDSPAPI_TOURNAMENT_ID=51216
# The bookmaker query accepts one book. Unibet posts all eight Round 1 matches.
ODDSPAPI_BOOKMAKER=unibet
